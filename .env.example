# Template for the two (git-ignored) env files. Real values must never be committed.
#
#   Final-Project/.env   -> local runs on your machine (ingestion script, dbt, Streamlit)
#   airflow/.env         -> injected into the Airflow Docker containers by `astro dev start`
#
# The only difference is the key path: a host path locally, a container path in
# Airflow (airflow/include/ is mounted at /usr/local/airflow/include).

SNOWFLAKE_ACCOUNT=<orgname-accountname>
SNOWFLAKE_USER=<your_user>
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=STOCKS_DB
# local:   C:/path/to/rsa_key.p8
# airflow: /usr/local/airflow/include/rsa_key.p8   (copy the key to airflow/include/)
SNOWFLAKE_PRIVATE_KEY_PATH=<path to rsa_key.p8>
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# --- airflow/.env only: Airflow connection `snowflake_default` ---
# AIRFLOW_CONN_SNOWFLAKE_DEFAULT='{"conn_type": "snowflake", "login": "<your_user>", "schema": "RAW", "extra": {"account": "<orgname-accountname>", "warehouse": "COMPUTE_WH", "database": "STOCKS_DB", "role": "ACCOUNTADMIN", "authenticator": "SNOWFLAKE_JWT", "private_key_file": "/usr/local/airflow/include/rsa_key.p8"}}'
