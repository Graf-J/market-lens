# Copy to .env (local dbt / ingestion / Streamlit) and airflow/.env (Astro).
# Real values must never be committed.
SNOWFLAKE_ACCOUNT=<orgname-accountname>
SNOWFLAKE_USER=<your_user>
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=STOCKS_DB
SNOWFLAKE_PRIVATE_KEY_PATH=<absolute path to rsa_key.p8>   # in Airflow: /usr/local/airflow/include/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
